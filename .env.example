# Copier en .env et renseigner avant docker compose up
# Stack sonde (Pi) uniquement — le central (backend/PostgreSQL/dashboard) a son
# propre .env, séparé, sur le Proxmox.

# ── Secrets obligatoires ──────────────────────────────────────────────────
WEBHOOK_TOKEN=

# ── Central (pour la détection locale de secours) ────────────────────────
# IP/hostname du central, atteignable via le tunnel WireGuard
CENTRAL_DASHBOARD_HOST=
CENTRAL_DASHBOARD_PORT=8000

# ── OpenSearch local ──────────────────────────────────────────────────────
# Pi 5 8 Go : -Xms3g -Xmx3g   |   dev/test : -Xms1g -Xmx1g (défaut)
# OS_JAVA_OPTS=-Xms3g -Xmx3g

# ── Collecte ──────────────────────────────────────────────────────────────
# Nom de la machine collecteur dans les logs (optionnel)
# COLLECTOR_HOSTNAME=con4mity-pi
