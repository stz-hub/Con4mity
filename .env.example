# Copier en .env et renseigner avant docker compose up

# ── Secrets obligatoires ──────────────────────────────────────────────────
JWT_SECRET=
PG_PASSWORD=
WEBHOOK_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────
PG_NAME=con4mity
PG_USER=con4mity

# ── OpenSearch ────────────────────────────────────────────────────────────
# Pi 5 8 Go : -Xms3g -Xmx3g   |   dev/test : -Xms1g -Xmx1g (défaut)
# OS_JAVA_OPTS=-Xms3g -Xmx3g

# ── Collecte ──────────────────────────────────────────────────────────────
# Nom de la machine collecteur dans les logs (optionnel)
# COLLECTOR_HOSTNAME=con4mity-collector
