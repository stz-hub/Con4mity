# Copier en .env et renseigner les valeurs (ne pas committer .env)

JWT_SECRET=
JWT_EXPIRE_HOURS=24
# Hachage clés API (défaut = JWT_SECRET — en prod, valeur dédiée)
# API_KEY_PEPPER=
# Comma-separated CIDR : si défini, seules ces plages atteignent /api/* (sauf /api/health)
# CON4MITY_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
# Politique mots de passe (si table security_policy absente, sinon l’admin l’enregistre en base)
# PASSWORD_MIN_LENGTH=12
# PASSWORD_REQUIRE_UPPER=1
# PASSWORD_REQUIRE_LOWER=1
# PASSWORD_REQUIRE_DIGIT=1
# PASSWORD_REQUIRE_SPECIAL=0
# Limite de tentatives de connexion par couple IP+utilisateur
# LOGIN_MAX_FAILED_PER_IP_USER=10
# LOGIN_RATE_WINDOW_SEC=900

PG_HOST=
PG_NAME=
PG_USER=
PG_PASSWORD=

OS_HOST=
OS_PORT=9200
# Préfixe d’index logs OpenSearch
# OS_LOGS_INDEX=con4mity-logs-*
# Fichier « heartbeat » optionnel (mtime récent = Filebeat actif)
# FILEBEAT_HEARTBEAT_FILE=/var/lib/filebeat/heartbeat

# Optionnel : chemin absolu vers le dossier frontend si différent du défaut
# FRONTEND_DIR=
